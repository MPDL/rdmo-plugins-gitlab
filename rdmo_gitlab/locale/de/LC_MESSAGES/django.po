#: forms/custom_fields.py:43
msgid "A file path is required."
msgstr "Ein Dateipfad ist erforderlich."

#: forms/custom_fields.py:122
msgid "At least one choice must be selected."
msgstr "Mindestens eine Option muss ausgewählt werden."

#: forms/custom_validators.py:14
msgid "whitespace"
msgstr "Leerzeichen"

#: forms/custom_validators.py:19
#, python-brace-format
msgid ""
"{field_name} contains special character(s): \"{spec_chars}\". Allowed "
"characters are: {allowed_char_name_str}."
msgstr ""
"{field_name} beinhaltet Sonderzeichen: \"{spec_chars}\". Diese sind die "
"erlaubten Zeichen: {allowed_char_name_str}."

#: forms/custom_validators.py:29
#, python-brace-format
msgid ""
"{field_name} must have at most {max_length} characters (it has {len_value})."
msgstr ""
"{field_name} darf höchstens {max_length} Zeichen enthalten (er hat "
"{len_value})."

#: forms/custom_validators.py:39
#, python-brace-format
msgid ""
"{field_name} must have at least {min_length} characters (it has {len_value})."
msgstr ""
"{field_name} muss mindestens {min_length} Zeichen enthalten (er hat "
"{len_value})."

#: forms/custom_validators.py:51
msgid "Repository name"
msgstr "Name des Repositoriums"

#: forms/custom_validators.py:55
msgid "alphanumeric, hyphen, underscore, period, plus sign and whitespace"
msgstr ""
"alphanumerisch, Bindestrich, Unterstrich, Punkt, Pluszeichen und Leerzeichen"

#: forms/custom_validators.py:66
#, python-brace-format
msgid "{field_name} must start with a letter or a digit."
msgstr "{field_name} muss mit einem Buchstaben oder einer Ziffer beginnen."

#: forms/custom_validators.py:74
#, python-brace-format
msgid ""
"{field_name} must not end with hyphen, underscore, period, \".git\" or \"."
"atom\"."
msgstr ""
"{field_name} darf nicht mit Bidestrich, Unterstrich, Punkt, \".git\" oder \"."
"atom\" enden."

#: forms/custom_validators.py:84 forms/forms.py:119
#: templates/plugins/exports_multivalue_select_option.html:16
msgid "File path"
msgstr "Dateipfad"

#: forms/custom_validators.py:88
msgid "alphanumeric, slash, hyphen, underscore, and period"
msgstr "alphanumerisch, Slash, Bindestrich, Unterstrich und Punkt"

#: forms/custom_validators.py:95
msgid "File must be in XML format."
msgstr "Die Datei muss im XML-Format vorliegen."

#: forms/custom_widgets.py:9
msgid "Special characters will be percent-encoded"
msgstr "Sonderzeichen werden prozentkodiert"

#: forms/custom_widgets.py:10
msgid "example_folder/example_file.extension"
msgstr "beispiel_ordner/beispiel_datei.dateikennung"

#: forms/forms.py:28
msgid ""
"Warning: Existing content in GitLab will be overwritten. To avoid this, "
"consider updating the file path or the branch."
msgstr ""
"Warnung: Bestehende Inhalte in GitLab werden überschrieben. Um dies zu "
"vermeiden, können der Dateipfad oder der Branch geändert werden"

#: forms/forms.py:39
msgid "Create new repository"
msgstr "Neues Repositorium anlegen"

#: forms/forms.py:48
msgid "Name for the new repository"
msgstr "Name des neuen Repositoriums"

#: forms/forms.py:49
msgid ""
"Unique name for the new repository. No other of your repositories may have "
"the same name, otherwise the export will fail."
msgstr ""
"Eindeutiger Name für das neue Repositorium. Kein anderes Ihrer Repositorien "
"darf denselben Namen haben, da sonst der Export fehlschlägt."

#: forms/forms.py:55 forms/forms.py:107 forms/forms.py:113
msgid "GitLab repository"
msgstr "GitLab-Repositorium"

#: forms/forms.py:61
msgid "Export choices"
msgstr "Optionen zum Exportieren"

#: forms/forms.py:62
msgid "Warning: Existing content in GitLab will be overwritten."
msgstr "Warnung: Bestehende Inhalte in GitLab werden überschrieben."

#: forms/forms.py:66
msgid "Select all export choices"
msgstr "Alle Optionen auswählen"

#: forms/forms.py:71
msgid "Branch"
msgstr "Branch"

#: forms/forms.py:72
msgid ""
"An existing branch in the GitLab repository. For a new repository it must be "
"the default branch \"main\"."
msgstr ""
"Ein bestehender Branch im GitLab-Repositorium. Bei einem neuen Repositorium "
"muss er der Standardbranch „main“ sein."

#: forms/forms.py:76
msgid "Commit message"
msgstr "Commitnachricht"

#: forms/forms.py:85
msgid "A name for the new repository is required."
msgstr "Ein Name für das neue Repositorium ist erforderlich."

#: forms/forms.py:88 forms/forms.py:137 forms/forms.py:140
msgid "A GitLab repository is required."
msgstr "Ein GitLab-Repositorium ist erforderlich."

#: forms/forms.py:97
#, python-brace-format
msgid "{source_title}/example-owner/example-repo"
msgstr "{source_title}/beispiel-besitzerin/beispiel-repo"

#: forms/forms.py:101
msgid "Use other repository"
msgstr "Ein anderes Repositorium benutzen"

#: forms/forms.py:114
msgid ""
"URL of GitLab repository you want to import from. If this repository is not "
"public, you must have access to it."
msgstr ""
"URL des GitLab-Repositoriums, aus dem Sie importieren möchten. Wenn dieses "
"Repositorium nicht öffentlich ist, muss es für Sie zugänglich sein."

#: forms/forms.py:120
msgid ""
"The import file's relative path in the repository. The file must be in XML "
"format."
msgstr ""
"Der relative Pfad der Importdatei im Repository. Die Datei muss im XML-"
"Format vorliegen."

#: forms/forms.py:121
msgid "example_folder/example_xml_file.xml"
msgstr "beispiel_ordner/beispiel_xml_datei.xml"

#: forms/forms.py:126
msgid "Branch, tag, or commit"
msgstr "Branch, Tag, oder Commit"

#: mixins.py:91 mixins.py:125
msgid "GitLab callback error"
msgstr "GitLab-Callback-Fehler"

#: mixins.py:92
msgid "State parameter did not match."
msgstr "Der Parameter 'state' stimmt nicht überein."

#: mixins.py:126
msgid "No redirect could be found."
msgstr "Kein redirect gefunden."

#: mixins.py:210
msgid ""
"To connect to GitLab repositories, you first need to authorize the MPDL app."
msgstr ""
"Die Verbindung zu GitLab-Repositorien erfordert die Autorisierung der MPDL-"
"App."

#: mixins.py:215
msgid ""
"These are your most recently updated, accessible GitLab repositories (up to "
"10 will be shown here). \n"
"                To add another repository to this list, please update the "
"repository and reload this page."
msgstr ""
"Das sind Ihre zuletzt aktualisierten, zugänglichen GitLab-Repositorien (bis "
"zu 10 werden hier angezeigt). Um ein weiteres Repositorium zu dieser Liste "
"hinzuzufügen, aktualisieren Sie das Repositorium und laden Sie diese Seite "
"neu."

#: providers/exports.py:26
msgid "RDMO XML"
msgstr "RDMO XML"

#: providers/exports.py:27
msgid "CSV (comma separated)"
msgstr "CSV (Komma getrennt)"

#: providers/exports.py:28
msgid "CSV (semicolon separated)"
msgstr "CSV (Semikolon getrennt)"

#: providers/exports.py:29
msgid "JSON"
msgstr "JSON"

#: providers/exports.py:66 providers/exports.py:104
msgid "Proceed"
msgstr "Fortfahren"

#: providers/exports.py:94
msgid "Something went wrong"
msgstr "Etwas ist schief gelaufen"

#: providers/exports.py:95
msgid ""
"Export choices could not be created or repository content would have been "
"overwritten without a warning."
msgstr ""
"Export-Optionen konnten nicht erstellt werden oder der Inhalt des Repository "
"wäre ohne Warnung überschrieben worden."

#: providers/exports.py:104 providers/exports.py:155
msgid "Export to GitLab"
msgstr "Nach GitLab exportieren"

#: providers/exports.py:208
msgid "not exported - it would have overwritten existing file in repository."
msgstr ""
"nicht exportiert - es hätte die bestehende Datei im Repository überschrieben."

#: providers/exports.py:216
msgid "not exported - it could not be created."
msgstr "nicht exportiert - es konnte nicht erstellt werden."

#: providers/exports.py:219
msgid "successfully exported."
msgstr "erfolgreich exportiert."

#: providers/exports.py:285
msgid "Add GitLab integration"
msgstr "GitLab-Integration hinzufügen"

#: providers/exports.py:286
msgid "Send to GitLab"
msgstr "An GitLab senden"

#: providers/exports.py:290
#, python-brace-format
msgid ""
"This integration allows the creation of issues in arbitrary repositories on "
"{self.gitlab_url}. The upload of attachments is not supported by GitLab."
msgstr ""
"Diese Integration ermöglicht die Erstellung von Issues in beliebigen "
"Repositorien in {self.gitlab_url}. Das Hochladen von Anhängen wird von "
"GitLab nicht unterstützt."

#: providers/exports.py:297
msgid "The URL of the GitLab repository to send issues to."
msgstr ""
"Die URL des GitLab-Repositoriums, an das Issues gesendet werden sollen."

#: providers/exports.py:302
msgid "The secret for a GitLab webhook to close a task (optional)."
msgstr ""
"Das 'secret' für einen GitLab-Webhook zum Schließen einer Aufgabe (optional)."

#: templates/plugins/exports_multivalue_select_option.html:12
msgid "File exists and will be overwritten"
msgstr "Die Datei existiert und wird überschrieben"

#: templates/plugins/exports_multivalue_select_option.html:12
msgid "File does not exist yet"
msgstr "Die Datei existiert noch nicht"

#: templates/plugins/gitlab_export_form.html:12
#, python-format
msgid "Export to %(source_title)s "
msgstr "Nach %(source_title)s exportieren"

#: templates/plugins/gitlab_export_success.html:6
#, python-format
msgid "Successful Export to %(source_title)s"
msgstr "Erfolgreicher Export nach %(source_title)s"

#: templates/plugins/gitlab_export_success.html:14
msgid "Go to GitLab repo"
msgstr "Zum GitLab-Repositorium"
